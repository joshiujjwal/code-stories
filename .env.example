# Environment Variables — CodeStories
# Copy this to .env.local and fill in your values
# NEVER commit .env.local

# PostgreSQL connection string (local dev)
DATABASE_URL="postgresql://postgres:password@localhost:5432/codestories"

# Separate DB for integration tests (keeps test data isolated)
DATABASE_URL_TEST="postgresql://postgres:password@localhost:5432/codestories_test"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# GitHub OAuth App (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
